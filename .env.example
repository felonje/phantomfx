# PostgreSQL connection string. `docker compose up -d db` starts a matching local database.
DATABASE_URL="postgresql://phantomfx:phantomfx@localhost:5432/phantomfx?schema=public"

# Long random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@phantomfx.local"
ADMIN_PASSWORD="ChangeMe123!"

# Price feed: "yahoo" (live market prices, falls back to simulated if unreachable) or "simulated"
PRICE_FEED="yahoo"

# Enforce FX market hours (Sun 22:00 - Fri 22:00 UTC). Set to "false" to allow trading 24/7.
ENFORCE_MARKET_HOURS="true"

# Starting balance for demo accounts (USD)
DEMO_BALANCE="10000"

# Public URL used in links inside emails (verification, password reset)
APP_URL="http://localhost:3000"
# Outgoing mail. Leave SMTP_URL empty in development: emails are printed to the server log instead.
# e.g. smtps://user:pass@smtp.resend.com:465
SMTP_URL=""
MAIL_FROM="PhantomFX <no-reply@phantomfx.com>"

# Shown on the Terms / Privacy / Risk Disclosure pages
NEXT_PUBLIC_COMPANY_NAME="PhantomFX"
NEXT_PUBLIC_SUPPORT_EMAIL="support@phantomfx.com"
