generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  country      String?
  passwordHash String
  role         String    @default("USER") // USER | ADMIN
  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt    DateTime  @default(now())
  accounts     Account[]
}

model Account {
  id           String        @id @default(cuid())
  login        Int           @unique
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // DEMO | LIVE
  currency     String        @default("USD")
  balance      Float         @default(0)
  leverage     Int           @default(100)
  createdAt    DateTime      @default(now())
  orders       Order[]
  positions    Position[]
  transactions Transaction[]

  @@unique([userId, type])
}

model Order {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol     String
  side       String // BUY | SELL
  type       String // MARKET | LIMIT | STOP
  volume     Float
  price      Float? // trigger price for pending orders, fill price once filled
  stopLoss   Float?
  takeProfit Float?
  status     String // PENDING | FILLED | CANCELLED | REJECTED
  reason     String?
  positionId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accountId, status])
  @@index([status])
}

model Position {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol      String
  side        String // BUY | SELL
  volume      Float
  openPrice   Float
  stopLoss    Float?
  takeProfit  Float?
  margin      Float
  commission  Float     @default(0)
  status      String    @default("OPEN") // OPEN | CLOSED
  closePrice  Float?
  closeReason String? // MANUAL | SL | TP | STOP_OUT | ADMIN
  profit      Float?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  @@index([accountId, status])
  @@index([status])
}

model Transaction {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          String // DEPOSIT | WITHDRAWAL | TRADE | COMMISSION | ADJUSTMENT | DEMO_RESET
  amount        Float // signed effect on balance
  status        String    @default("COMPLETED") // PENDING | COMPLETED | REJECTED
  method        String?
  reference     String?
  note          String?
  positionId    String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([accountId, createdAt])
  @@index([status, type])
}

model Instrument {
  symbol           String  @id
  description      String
  digits           Int
  pipSize          Float
  contractSize     Float   @default(100000)
  spreadPips       Float
  commissionPerLot Float   @default(0)
  minLot           Float   @default(0.01)
  maxLot           Float   @default(50)
  enabled          Boolean @default(true)
  sort             Int     @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
